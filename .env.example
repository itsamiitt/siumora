# Legend: [prod-required] = Medusa (apps/medusa/src/boot-guards.ts) refuses to
# boot with APP_ENV=production when it is missing; [prod] = needed for a
# working production shop but not boot-enforced.

# Which environment this is: development | staging | production. Gates every
# production guard (NODE_ENV cannot tell staging from production — managed
# staging runs NODE_ENV=production). Medusa refuses to boot with
# NODE_ENV=production and APP_ENV unset. [prod-required]
APP_ENV=development

# Postgres. Local: run ./tooling/postgres.sh start and use the URL it prints.
# Production: Supabase (aws ap-south-1) or RDS Mumbai.
DATABASE_URL=postgresql://siumora@localhost:5433/postgres
DATABASE_SSL=false

# API service. The storefront calls this at build time as well as at request
# time, so it must be reachable when apps/web builds.
API_URL=http://localhost:4000
# Set to coming-soon to show the waiting list publicly and password-gate the store.
SITE_PHASE=storefront
# Exactly four digits, including leading zeros. Server-only; changing it revokes previews.
COMING_SOON_PREVIEW_PASSWORD=
# Independent random secret (32+ characters) for signing preview sessions. Server-only.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COMING_SOON_PREVIEW_SECRET=
PORT=4000
# Comma-separated origins allowed to call the API. Never "*" in production.
CORS_ORIGINS=http://localhost:3000

# Statutory disclosures. Unset values render a "not ready to publish" notice.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_CIN=
# private-limited (default, needs CIN) | llp (needs LLPIN) | proprietorship.
NEXT_PUBLIC_LEGAL_ENTITY_TYPE=
NEXT_PUBLIC_LLPIN=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_GRIEVANCE_EMAIL=

NEXT_PUBLIC_SITE_URL=https://siumora.com

# Webhook signing secrets. Requests are rejected without a valid signature.
RAZORPAY_WEBHOOK_SECRET=
COURIER_WEBHOOK_SECRET=

# Sign-in. Numbers that may open /admin, comma separated and in any format —
# they are normalised. Checked on every request, so removing one closes the
# door immediately rather than when a session lapses.
# Append :role to narrow one (viewer, support, operator, owner); bare = owner.
ADMIN_PHONES=

# Medusa dashboard users' roles, comma separated email:role
# (ops@siumora.in:operator,help@siumora.in:support). Unset, every dashboard
# user is an owner (development only); set, a user not listed is a viewer.
# [prod-required]: must list at least one email:owner — production never
# falls back to everyone-is-owner.
ADMIN_USER_ROLES=

# Break-glass only: "off" suspends the staff two-step sign-in requirement for
# the Siumora ops pages (an owner who lost their authenticator). Remove it the
# moment they have re-enrolled.
SIUMORA_STAFF_MFA=

# Messaging providers (eng review 4A). Each channel exists only when its
# credentials are complete; with none set the outbox marks messages skipped
# and /auth/otp refuses unless OTP_ECHO is on.
#
# WhatsApp via a BSP (Interakt-compatible). TEXT_TEMPLATE is one approved
# pass-through template whose single body parameter carries the rendered
# message; OTP_TEMPLATE is the approved authentication template.
WHATSAPP_BSP_URL=
WHATSAPP_BSP_KEY=
WHATSAPP_TEXT_TEMPLATE=
WHATSAPP_OTP_TEMPLATE=

# SMS via MSG91 under TRAI DLT. Per-message DLT template ids live on the core
# notification templates; the OTP flow has its own registered template.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# With both WhatsApp and SMS configured, sign-in codes go on WhatsApp first and
# fall back to SMS when WhatsApp fails or times out; shoppers can also ask for
# SMS after 20 seconds. For Android to read the code automatically (WebOTP),
# the DLT OTP template must end with its own line: "@siumora.in #{code}".

# Cloudflare Turnstile on "Send code" (auth plan phase 1). Set BOTH or neither:
# the site key renders the widget, the secret makes Medusa require it.
# Both [prod-required] (the secret is boot-enforced; the site key must match).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google sign-in (auth plan phase 4). Both set = Medusa registers the provider;
# the owner still switches it on (and picks the A/B share) under Settings →
# Customer sign-in. Register {STOREFRONT_URL}/auth/google/callback as the
# authorised redirect URI in Google Cloud. A Google account links to a
# customer only after an OTP proves their phone.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The storefront's public origin, as Medusa should write it into links it
# sends (Google's redirect, email verification). No trailing slash.
# [prod-required]: unset or localhost refuses a production boot.
STOREFRONT_URL=https://siumora.com

# Shared secret (32+ characters) the storefront uses to sign the shopper IP it
# forwards to Medusa (x-siumora-client-ip-sig). Same value in apps/web and
# apps/medusa. Unset, Medusa ignores the forwarded IP and rate limits key on
# the storefront server. [prod-required]
CLIENT_IP_SECRET=

# Signs the short-lived Google link and email verification tokens. Falls back
# to JWT_SECRET; set its own value to rotate one without the other. Production
# refuses the source-code dev defaults.
SIUMORA_TOKEN_SECRET=

# Keys the phone numbers in the sign-in event log (an HMAC, never the number).
# Falls back to JWT_SECRET; set its own value to rotate one without the other.
AUTH_EVENT_SECRET=

# Email via Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Authenticates the BSP's delivery-receipt webhook (POST /webhooks/messaging).
# Medusa (plan 16 Phase G): HMAC-SHA256 of the raw body in x-messaging-signature.
MESSAGING_WEBHOOK_SECRET=

# Which outbox the worker drains (plan 16 Phases G, J): unset means the Medusa
# one (siumora_notifications / siumora_tracking_events on MEDUSA_DATABASE_URL);
# "fastify" names the old ledger on DATABASE_URL until Fastify is retired.
OUTBOX_BACKEND=

# API credentials for Razorpay (plan W1). Absent, checkout records the order
# and says plainly that no payment was taken.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Courier account (plan W1). Absent, POST /orders/:number/ship answers 503.
# Note: Shiprocket push webhooks are reported as Growth-plan-and-above —
# verify at KYC signup (eng review 3A).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# Medusa (plan 16 Phase F): the token set in the Shiprocket panel for its
# tracking webhook to /webhooks/courier, sent as x-api-key. All four can be
# set in Admin › Settings › Integrations instead, which wins over these.
SHIPROCKET_WEBHOOK_TOKEN=

# DEVELOPMENT ONLY: "true" returns the sign-in code in the API response
# instead of sending it. Leave blank anywhere real; the API and Medusa refuse
# to boot with it set in production. Local dev: OTP_ECHO=true.
OTP_ECHO=

# E2E / local only: "true" turns the rate limiter off. Refused at boot in
# production.
DISABLE_RATE_LIMITS=

# Lets a customer drive courier transitions on their own order, so the
# delivered/NDR/returns paths can be walked without a courier account. Defaults
# on outside production; set false to require an operator. Medusa refuses to
# boot with it set to true in production (plan 16 B30).
COURIER_SIMULATION=

# Conversion destinations. Unset means conversions are still built and written
# to the ledger — marked `skipped` — so the parity report can tell "not
# configured" apart from "nothing happened".
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_TOKEN=

# Browser tags (eng review 8A). GTM loads via the framework's optimized
# loader; the Pixel base additionally waits for ads consent and first idle.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Medusa (Track M — apps/medusa) ──────────────────────────────────────────
# Its own database during dual-run (DB-new). Local dev default is
# postgresql://postgres:postgres@localhost:5432/siumora_medusa; production
# boot refuses to start without an explicit URL.
# [prod-required]
MEDUSA_DATABASE_URL=
MEDUSA_ADMIN_URL=http://localhost:9000

# Unset locally: Medusa dev runs on the in-memory event bus and workflow
# engine. Production points at Upstash Mumbai — this is a checkout-path
# dependency (workflow engine + event bus), priced in the design doc; the
# incident runbook's "Redis down" entry covers the outage mode. Required in
# production (boot refuses without it): the rate-limit counters are shared
# here, so every instance enforces one ceiling and a restart forgets nothing.
# When set, medusa-config.ts also registers the Redis event bus, workflow
# engine, cache and locking modules. [prod-required]
MEDUSA_REDIS_URL=

# shared (default: one process does HTTP + jobs/subscribers) | server (HTTP
# only) | worker (jobs/subscribers only, admin disabled). Split modes need
# MEDUSA_REDIS_URL — the halves talk through Redis.
MEDUSA_WORKER_MODE=

# Dev defaults exist for both; production boot refuses the dev defaults.
# [prod-required]
JWT_SECRET=
COOKIE_SECRET=

# Base URL of the Medusa store API for the M1 transport (packages/sdk/medusa).
# Local dev: http://localhost:9000. Like API_URL, no default — a build that
# silently points at a machine that is not there fails later and worse.
MEDUSA_URL=

# Publishable API key for Medusa's store API — the M1 Medusa transport sends
# it as the x-publishable-api-key header. The seed prints it on every run:
# `cd apps/medusa && npx medusa exec ./src/scripts/seed.ts`. Server env only,
# like COMMERCE_BACKEND: scoped storefront credential, not a browser bake-in.
MEDUSA_PUBLISHABLE_KEY=

# Admin dashboard (M4). The dashboard serves same-origin at <backend>/app;
# unset, the CORS defaults admit localhost 9000 (Medusa default / CI) and
# 9101 (local no-watcher convention). Production sets the real admin origin.
# Both [prod-required] in production, and must not point at localhost.
ADMIN_CORS=
AUTH_CORS=

# Origins allowed to call the store API from a browser. Unset, it defaults to
# http://localhost:3000. The storefront calls Medusa server-side, so this only
# matters for browser calls; production sets the storefront origin
# (https://siumora.com) so a stray browser call is not silently refused.
# [prod-required], not localhost.
STORE_CORS=

# Product images (M4). Unset, Medusa's file-local provider stores uploads
# under apps/medusa/static and serves them from the backend — dev needs
# nothing. Production is Cloudflare R2 via the S3-compatible provider: the
# module block engages only when S3_FILE_URL is set (a half-configured
# provider never shadows the local default). R2: endpoint is the account
# endpoint, region stays "auto", file_url is the public bucket/custom domain.
# S3_FILE_URL, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_BUCKET are
# [prod-required] (the local fallback stamps localhost into image URLs).
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=

# When R2 is not configured and the backend sits behind a reverse proxy, the
# file-local provider must stamp the PUBLIC origin into upload rows, not its
# own localhost (the URL is baked at write time). E.g.
# https://siumora.com/static with nginx proxying /static to the backend.
# Unset in dev — localhost is exactly right there.
FILE_LOCAL_BACKEND_URL=

# Which backend the storefront's server-side client talks to. Server env only
# (never NEXT_PUBLIC_*). medusa|fastify; unset means medusa, the launch path
# (plan 16 Phase J) — set MEDUSA_URL and MEDUSA_PUBLISHABLE_KEY. `fastify`
# stays selectable by name until scripts/retire-fastify.mjs removes it
# (docs/fastify-retirement.md).
COMMERCE_BACKEND=

# Medusa control center: encrypts saved provider credentials. Generate a random
# secret (at least 32 characters), keep it outside the database, and back it up.
# Existing environment provider credentials work until overridden in admin.
# [prod-required]. Losing or rotating it disables every saved provider (logged
# as [money-alert] provider settings could not be decrypted).
SETTINGS_ENCRYPTION_KEY=

# The storefront's next/image allow-list entry for the production image host
# (the S3_FILE_URL hostname, no scheme). [prod]
MEDUSA_IMAGE_HOST=

# Seller identity printed on tax invoices (GET .../invoice.pdf answers 503
# until all six are set). SELLER_STATE_CODE is the two-digit GST state code
# (e.g. 27 for Maharashtra). [prod]
SELLER_NAME=
SELLER_ADDRESS=
SELLER_GSTIN=
SELLER_STATE_CODE=
SELLER_EMAIL=
SELLER_PHONE=

# apps/worker poll interval for the outbox, in milliseconds (default 15000).
WORKER_INTERVAL_MS=

# Seeds (apps/medusa/src/scripts/seed.ts, packages/db seed) refuse to run when
# APP_ENV or NODE_ENV is production — they reset stock / delete the catalogue.
# Set SEED_FORCE=1 for that one command only if you really mean it.
SEED_FORCE=

# Error reporting (Sentry). Off when the DSN is blank. SENTRY_DSN serves the
# web server, Medusa and the worker; NEXT_PUBLIC_SENTRY_DSN the browser.
# Medusa log lines starting "[money-alert]" are sent as Sentry messages
# tagged alert:money — page on those.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Build-time only, for source-map upload; leave blank to skip uploading.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Fastify API only (apps/api, being retired): encrypts staff TOTP secrets, and
# trusts X-Forwarded-For behind a proxy.
TOTP_ENCRYPTION_KEY=
TRUST_PROXY=
