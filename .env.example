# Postgres. Local: run ./tooling/postgres.sh start and use the URL it prints.
# Production: Supabase (aws ap-south-1) or RDS Mumbai.
DATABASE_URL=postgresql://siumora@localhost:5433/postgres
DATABASE_SSL=false

# API service. The storefront calls this at build time as well as at request
# time, so it must be reachable when apps/web builds.
API_URL=http://localhost:4000
PORT=4000
# Comma-separated origins allowed to call the API. Never "*" in production.
CORS_ORIGINS=http://localhost:3000

# Statutory disclosures. Unset values render a "not ready to publish" notice.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_CIN=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_GRIEVANCE_EMAIL=

NEXT_PUBLIC_SITE_URL=https://siumora.com

# Webhook signing secrets. Requests are rejected without a valid signature.
RAZORPAY_WEBHOOK_SECRET=
COURIER_WEBHOOK_SECRET=

# Sign-in. Numbers that may open /admin, comma separated and in any format —
# they are normalised. Checked on every request, so removing one closes the
# door immediately rather than when a session lapses.
ADMIN_PHONES=

# Set once a WhatsApp/DLT template sender exists. Until then /auth/otp refuses
# unless OTP_ECHO is on.
WHATSAPP_OTP_TEMPLATE=

# Development only: return the sign-in code in the API response instead of
# sending it. The API refuses to boot with this set in production.
OTP_ECHO=true

# Lets a customer drive courier transitions on their own order, so the
# delivered/NDR/returns paths can be walked without a courier account. Defaults
# on outside production; set false to require an operator.
COURIER_SIMULATION=

# Conversion destinations. Unset means conversions are still built and written
# to the ledger — marked `skipped` — so the parity report can tell "not
# configured" apart from "nothing happened".
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_TOKEN=
