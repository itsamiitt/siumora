{
  "name": "@siumora/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "import": "./src/auth.ts",
      "require": "./dist/auth.cjs"
    },
    "./facets": {
      "types": "./src/facets.ts",
      "import": "./src/facets.ts",
      "require": "./dist/facets.cjs"
    },
    "./gstin": {
      "types": "./src/gstin.ts",
      "import": "./src/gstin.ts",
      "require": "./dist/gstin.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/auth.ts src/facets.ts src/gstin.ts --format cjs --sourcemap --clean --target node22",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@siumora/config-ts": "workspace:*",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
