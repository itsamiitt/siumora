{
  "name": "@siumora/analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "require": "./dist/server.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format cjs --sourcemap --clean --target node22",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@siumora/config-ts": "workspace:*",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
