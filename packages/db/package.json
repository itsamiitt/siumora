{
  "name": "@siumora/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "node --experimental-strip-types src/cli-migrate.ts",
    "seed": "node --experimental-strip-types src/seed.ts",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "@siumora/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@siumora/config-ts": "workspace:*",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.20.0",
    "typescript": "^5.9.3"
  }
}
